# Variable NAMES only. Values are intentionally empty so a host that imports this file
# (Railway "suggested variables") never picks up fake placeholder numbers or URLs.
# web = browser page as the callee (no Twilio needed), twilio = real phone calls.
# Empty: Twilio when fully configured, else web if OPENAI_API_KEY and PUBLIC_BASE_URL are set.
HERMES_PHONE_MODE=
# Twilio account SID, starts with AC (Twilio mode only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164, e.g. +1XXXXXXXXXX
TWILIO_FROM_NUMBER=

# Phase 1: Pluggable adapter credentials (Deepgram, xAI, ElevenLabs)
# Leave OpenAI key for backward compatibility with OpenAI Realtime adapter (optional)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=

# https://<your public domain>, no trailing slash
PUBLIC_BASE_URL=
# Comma-separated E.164 numbers that may be dialed. Empty = all dialing refused.
HERMES_PHONE_TEST_ALLOWLIST=
HERMES_PHONE_BRIDGE_PORT=
HERMES_PHONE_DB_PATH=

# Phase 1: Adapter configuration
# STT adapter: "deepgram" (default), "openai_realtime"
HERMES_PHONE_STT_ADAPTER=deepgram
# Deepgram language: "ar-SA", "ar-AE", "ar", "multi" (with language_hint=ar,en)
HERMES_PHONE_STT_LANGUAGE=multi
# LLM adapter: "xai" (default), "openai"
HERMES_PHONE_LLM_ADAPTER=xai
# xAI model: "grok-4.3" (default for live turns), "grok-4.7" (for async planning)
HERMES_PHONE_LLM_MODEL=grok-4.3
# xAI reasoning effort: "none" (default for live turns), "low", "medium", "high", "xhigh"
HERMES_PHONE_LLM_REASONING_EFFORT=none
# TTS adapter: "elevenlabs" (default), "openai_realtime"
HERMES_PHONE_TTS_ADAPTER=elevenlabs
# ElevenLabs voice ID or name
HERMES_PHONE_TTS_VOICE=

# Phase 1: Daily spend caps (Bahrain timezone)
# Max spend per Bahrain day in USD (default: 6.0)
HERMES_PHONE_MAX_DAILY_SPEND_USD=6.0
# Max minutes per Bahrain day (default: 20.0)
HERMES_PHONE_MAX_DAILY_MINUTES=20.0
# Max calls per Bahrain day (default: 10)
HERMES_PHONE_MAX_DAILY_CALLS=10

# Phase 1: Voicemail and retry policy
# Voicemail mode: "leave_callback" (default), "hangup_silent"
HERMES_PHONE_VOICEMAIL_MODE=leave_callback
# Callback number to speak in voicemail (Bahrain +973 mobile)
HERMES_PHONE_CALLBACK_NUMBER=
# Max retries on no_answer/busy/voicemail (default: 2)
HERMES_PHONE_MAX_RETRIES=2

# Phase 1: Ramadan reminder (not a block, just a reminder)
# Comma-separated date ranges: "2027-02-08,2027-03-10" (Feb 8 - Mar 10, 2027 estimated)
HERMES_PHONE_RAMADAN_DATES=

# Realtime voice model and voice (optional, for OpenAI Realtime adapter)
HERMES_PHONE_MODEL=
HERMES_PHONE_VOICE=
